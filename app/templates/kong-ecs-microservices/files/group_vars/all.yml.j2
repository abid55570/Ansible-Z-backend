---
# Generated by Ansible-Z for environment: {{ env }}
project_name: "{{ project_name }}"
environment_name: "{{ env }}"
aws_region: "{{ aws_region }}"
vpc_cidr: "{{ vpc_cidr }}"
public_a_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.1.0/24"
public_b_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.2.0/24"
private_a_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.11.0/24"
private_b_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.12.0/24"
az_a: "{{ aws_region }}a"
az_b: "{{ aws_region }}b"
ami_id: "{{ ami_id | default('ami-PLACEHOLDER') }}"
kong_image: "{{ kong_image | default('kong:3.6') }}"
service_image: "{{ service_image }}"
db_username: "{{ db_username | default('appadmin') }}"
db_password: "{{ db_password | default('CHANGE_ME_IN_VAULT') }}"
office_ip: "{{ office_ip | default('REPLACE_WITH_YOUR_VPN_CIDR') }}"

common_tags:
  Project: "{{ project_name }}"
  Environment: "{{ env }}"
  ManagedBy: ansible
  GeneratedBy: ansible-z
