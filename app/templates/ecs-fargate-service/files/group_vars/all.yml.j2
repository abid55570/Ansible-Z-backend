---
# Generated by Ansible-Z for environment: {{ env }}
project_name: "{{ project_name }}"
environment_name: "{{ env }}"
aws_region: "{{ aws_region }}"
vpc_cidr: "{{ vpc_cidr }}"
subnet_a_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.1.0/24"
subnet_b_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.2.0/24"
az_a: "{{ aws_region }}a"
az_b: "{{ aws_region }}b"
container_image: "{{ container_image }}"
container_port: "{{ container_port }}"
desired_count: "{{ desired_count }}"
task_cpu: "{{ task_cpu | default('512') }}"
task_memory: "{{ task_memory | default('1024') }}"

common_tags:
  Project: "{{ project_name }}"
  Environment: "{{ env }}"
  ManagedBy: ansible
  GeneratedBy: ansible-z
