{% raw %}---
# Basic secure VPC: public + private subnets, IGW, NAT egress, base security group.
# A network foundation to build on. Values come from group_vars/all.yml (auto-loaded).
- name: Provision secure VPC foundation
  hosts: localhost
  connection: local
  gather_facts: false
  collections:
    - amazon.aws
    - community.aws
  tasks:
    - name: Create VPC
      amazon.aws.ec2_vpc_net:
        name: "{{ project_name }}-{{ environment_name }}-vpc"
        cidr_block: "{{ vpc_cidr }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present
      register: vpc

    - name: Internet gateway
      amazon.aws.ec2_vpc_igw:
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present
      register: igw

    - name: Public subnet
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ public_subnet_cidr }}"
        region: "{{ aws_region }}"
        map_public: true
        tags: "{{ common_tags | combine({'Name': project_name + '-public', 'Role': 'public'}) }}"
        state: present
      register: public_subnet

    - name: Private subnet
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ private_subnet_cidr }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags | combine({'Name': project_name + '-private', 'Role': 'private'}) }}"
        state: present
      register: private_subnet

    - name: NAT gateway (egress for the private subnet)
      amazon.aws.ec2_vpc_nat_gateway:
        subnet_id: "{{ public_subnet.subnet.id }}"
        region: "{{ aws_region }}"
        wait: true
        if_exist_do_not_create: true
        tags: "{{ common_tags }}"
        state: present
      register: nat

    - name: Public route table to the internet gateway
      amazon.aws.ec2_vpc_route_table:
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        subnets:
          - "{{ public_subnet.subnet.id }}"
        routes:
          - dest: 0.0.0.0/0
            gateway_id: "{{ igw.gateway_id }}"
        tags: "{{ common_tags | combine({'Name': project_name + '-public-rt'}) }}"
        state: present

    - name: Private route table via the NAT gateway
      amazon.aws.ec2_vpc_route_table:
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        subnets:
          - "{{ private_subnet.subnet.id }}"
        routes:
          - dest: 0.0.0.0/0
            nat_gateway_id: "{{ nat.nat_gateway_id }}"
        tags: "{{ common_tags | combine({'Name': project_name + '-private-rt'}) }}"
        state: present

    - name: Base security group (SSH from office only, all egress)
      amazon.aws.ec2_security_group:
        name: "{{ project_name }}-base-sg"
        description: "Baseline: SSH from office, deny other inbound"
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        rules:
          - proto: tcp
            ports: [22]
            cidr_ip: "{{ office_ip }}"
            rule_desc: "SSH from office"
        rules_egress:
          - proto: -1
            cidr_ip: 0.0.0.0/0
            rule_desc: "all egress"
        tags: "{{ common_tags }}"
        state: present
{% endraw %}
