---
# Generated by Neviri-Ansi for environment: {{ env }}
project_name: "{{ project_name }}"
environment_name: "{{ env }}"
aws_region: "{{ aws_region }}"
vpc_cidr: "{{ vpc_cidr }}"
subnet_a_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.1.0/24"
subnet_b_cidr: "{{ vpc_cidr.split('.')[0] }}.{{ vpc_cidr.split('.')[1] }}.2.0/24"
az_a: "{{ aws_region }}a"
az_b: "{{ aws_region }}b"
instance_type: "{{ instance_type }}"
db_instance_class: "{{ db_instance_class | default('db.t3.small') }}"
ami_id: "{{ ami_id | default('ami-PLACEHOLDER') }}"
key_name: "{{ key_name | default('') }}"
db_username: "{{ db_username }}"
db_password: "{{ db_password | default('CHANGE_ME_IN_VAULT') }}"
office_ip: "{{ office_ip | default('REPLACE_WITH_YOUR_IP/32') }}"

common_tags:
  Project: "{{ project_name }}"
  Environment: "{{ env }}"
  ManagedBy: ansible
  GeneratedBy: neviri-ansi
