---
# Generated by Neviri-Ansi for environment: {{ env }}
project_name: "{{ project_name }}"
environment_name: "{{ env }}"
aws_region: "{{ aws_region }}"
bucket_name: "{{ bucket_name }}"
index_document: "{{ index_document | default('index.html') }}"
error_document: "{{ error_document | default('error.html') }}"

bucket_policy:
  Version: "2012-10-17"
  Statement:
    - Sid: PublicReadGetObject
      Effect: Allow
      Principal: "*"
      Action: "s3:GetObject"
      Resource: "arn:aws:s3:::{{ bucket_name }}/*"

common_tags:
  Project: "{{ project_name }}"
  Environment: "{{ env }}"
  ManagedBy: ansible
  GeneratedBy: neviri-ansi
