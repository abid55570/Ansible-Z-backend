{% raw %}---
- name: Provision EKS platform
  hosts: localhost
  connection: local
  gather_facts: false
  collections:
    - amazon.aws
  tasks:
    - name: VPC
      amazon.aws.ec2_vpc_net:
        name: "{{ cluster_name }}-vpc"
        cidr_block: "{{ vpc_cidr }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present
      register: vpc

    - name: Subnet A
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ subnet_a_cidr }}"
        az: "{{ aws_region }}a"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present
      register: subnet_a

    - name: Subnet B
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ subnet_b_cidr }}"
        az: "{{ aws_region }}b"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present
      register: subnet_b

    - name: EKS cluster (private API)
      community.aws.eks_cluster:
        name: "{{ cluster_name }}"
        region: "{{ aws_region }}"
        role_arn: "{{ cluster_role_arn }}"
        subnets:
          - "{{ subnet_a.subnet.id }}"
          - "{{ subnet_b.subnet.id }}"
        state: present

    - name: EKS managed node group
      community.aws.eks_nodegroup:
        name: "{{ cluster_name }}-ng"
        cluster_name: "{{ cluster_name }}"
        region: "{{ aws_region }}"
        node_role: "{{ node_role_arn }}"
        subnets:
          - "{{ subnet_a.subnet.id }}"
          - "{{ subnet_b.subnet.id }}"
        scaling_config:
          min_size: 1
          max_size: "{{ node_count }}"
          desired_size: "{{ node_count }}"
        state: present
{% endraw %}