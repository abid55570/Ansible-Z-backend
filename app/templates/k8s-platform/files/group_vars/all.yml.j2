{% set vpc = vpc_cidr | default('10.0.0.0/16') -%}
---
# Generated by Neviri-Ansi for environment: {{ env }}
cluster_name: "{{ cluster_name }}"
aws_region: "{{ aws_region }}"
node_count: {{ node_count | default(3) }}
vpc_cidr: "{{ vpc }}"
subnet_a_cidr: "{{ vpc.split('.')[0] }}.{{ vpc.split('.')[1] }}.1.0/24"
subnet_b_cidr: "{{ vpc.split('.')[0] }}.{{ vpc.split('.')[1] }}.2.0/24"
cluster_role_arn: "{{ cluster_role_arn | default('arn:aws:iam::000000000000:role/eks-cluster') }}"
node_role_arn: "{{ node_role_arn | default('arn:aws:iam::000000000000:role/eks-node') }}"
common_tags: { Project: "{{ cluster_name }}", ManagedBy: ansible, GeneratedBy: neviri-ansi }
