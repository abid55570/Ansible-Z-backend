{% raw %}---
# AWS Backup: an encrypted vault, a scheduled plan, and a tag-based selection.
# Values come from group_vars/all.yml (auto-loaded).
- name: Provision centralized backup
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Backup vault
      amazon.aws.backup_vault:
        backup_vault_name: "{{ project_name }}-vault"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present

    - name: Backup service role
      amazon.aws.iam_role:
        name: "{{ project_name }}-backup-role"
        assume_role_policy_document: >-
          { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow",
          "Principal": {"Service": "backup.amazonaws.com"}, "Action": "sts:AssumeRole" }] }
        managed_policies:
          - "arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup"
        state: present
      register: backup_role

    - name: Backup plan (daily, with retention)
      amazon.aws.backup_plan:
        backup_plan_name: "{{ project_name }}-plan"
        region: "{{ aws_region }}"
        rules:
          - rule_name: daily
            target_backup_vault_name: "{{ project_name }}-vault"
            schedule_expression: "{{ schedule }}"
            start_window_minutes: 60
            completion_window_minutes: 180
            lifecycle:
              delete_after_days: "{{ retention_days }}"
        tags: "{{ common_tags }}"
        state: present
      register: plan

    - name: Backup selection (resources tagged Backup=true)
      amazon.aws.backup_selection:
        selection_name: "{{ project_name }}-selection"
        backup_plan_name: "{{ project_name }}-plan"
        iam_role_arn: "{{ backup_role.arn }}"
        list_of_tags:
          - condition_type: STRINGEQUALS
            condition_key: Backup
            condition_value: "true"
        region: "{{ aws_region }}"
        state: present
{% endraw %}
