{% raw %}---
- name: Provision serverless event-driven stack
  hosts: localhost
  connection: local
  gather_facts: false
  collections:
    - amazon.aws
    - community.aws
  tasks:
    - name: DynamoDB table (on-demand)
      community.aws.dynamodb_table:
        name: "{{ table_name }}"
        region: "{{ aws_region }}"
        hash_key_name: id
        hash_key_type: STRING
        billing_mode: PAY_PER_REQUEST
        tags: "{{ common_tags }}"
        state: present

    - name: Lambda function
      amazon.aws.lambda:
        name: "{{ project_name }}-fn"
        region: "{{ aws_region }}"
        runtime: "{{ runtime }}"
        handler: app.handler
        role: "{{ lambda_role_arn }}"
        zip_file: "{{ lambda_zip | default('build/function.zip') }}"
        state: present

    - name: EventBridge schedule -> Lambda
      amazon.aws.cloudwatchevent_rule:
        name: "{{ project_name }}-schedule"
        region: "{{ aws_region }}"
        schedule_expression: "rate(5 minutes)"
        state: present
        targets:
          - id: lambda
            arn: "arn:aws:lambda:{{ aws_region }}:000000000000:function:{{ project_name }}-fn"
{% endraw %}