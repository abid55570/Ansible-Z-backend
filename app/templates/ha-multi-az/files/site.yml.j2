{% raw %}---
# Multi-AZ HA: ASG across two AZs behind an ALB, with RDS Multi-AZ.
# Values come from group_vars/all.yml (auto-loaded).
- name: Provision multi-AZ HA stack
  hosts: localhost
  connection: local
  gather_facts: false
  collections:
    - amazon.aws
    - community.aws
  tasks:
    - name: Create VPC
      amazon.aws.ec2_vpc_net:
        name: "{{ project_name }}-{{ environment_name }}-vpc"
        cidr_block: "{{ vpc_cidr }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present
      register: vpc

    - name: Internet gateway
      amazon.aws.ec2_vpc_igw:
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags }}"
        state: present

    - name: Public subnet A
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ public_subnet_a }}"
        az: "{{ az_a }}"
        region: "{{ aws_region }}"
        map_public: true
        tags: "{{ common_tags | combine({'Name': project_name + '-public-a', 'Role': 'public'}) }}"
        state: present
      register: pub_a

    - name: Public subnet B
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ public_subnet_b }}"
        az: "{{ az_b }}"
        region: "{{ aws_region }}"
        map_public: true
        tags: "{{ common_tags | combine({'Name': project_name + '-public-b', 'Role': 'public'}) }}"
        state: present
      register: pub_b

    - name: Private subnet A
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ private_subnet_a }}"
        az: "{{ az_a }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags | combine({'Name': project_name + '-private-a', 'Role': 'private'}) }}"
        state: present
      register: priv_a

    - name: Private subnet B
      amazon.aws.ec2_vpc_subnet:
        vpc_id: "{{ vpc.vpc.id }}"
        cidr: "{{ private_subnet_b }}"
        az: "{{ az_b }}"
        region: "{{ aws_region }}"
        tags: "{{ common_tags | combine({'Name': project_name + '-private-b', 'Role': 'private'}) }}"
        state: present
      register: priv_b

    - name: ALB security group
      amazon.aws.ec2_security_group:
        name: "{{ project_name }}-alb-sg"
        description: "ALB public"
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        rules:
          - proto: tcp
            ports: [80, 443]
            cidr_ip: 0.0.0.0/0
        tags: "{{ common_tags }}"
        state: present

    - name: App security group
      amazon.aws.ec2_security_group:
        name: "{{ project_name }}-app-sg"
        description: "App from ALB"
        vpc_id: "{{ vpc.vpc.id }}"
        region: "{{ aws_region }}"
        rules:
          - proto: tcp
            ports: [8080]
            group_name: "{{ project_name }}-alb-sg"
        tags: "{{ common_tags }}"
        state: present

    - name: Find latest Ubuntu 22.04 AMI
      amazon.aws.ec2_ami_info:
        region: "{{ aws_region }}"
        owners: ["099720109477"]
        filters:
          name: "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"
      register: ami

    - name: Resolve latest AMI id
      ansible.builtin.set_fact:
        latest_ami: "{{ (ami.images | sort(attribute='creation_date') | last).image_id }}"

    - name: Create launch template
      amazon.aws.ec2_launch_template:
        name: "{{ project_name }}-app-lt"
        region: "{{ aws_region }}"
        instance_type: t3.micro
        image_id: "{{ latest_ami }}"
        tags: "{{ common_tags }}"

    - name: Create target group
      community.aws.elb_target_group:
        name: "{{ project_name }}-tg"
        region: "{{ aws_region }}"
        protocol: HTTP
        port: 8080
        vpc_id: "{{ vpc.vpc.id }}"
        target_type: instance
        health_check_path: /
        health_check_protocol: HTTP
        state: present

    - name: Create application load balancer (multi-AZ)
      amazon.aws.elb_application_lb:
        name: "{{ project_name }}-alb"
        region: "{{ aws_region }}"
        subnets:
          - "{{ pub_a.subnet.id }}"
          - "{{ pub_b.subnet.id }}"
        security_groups:
          - "{{ project_name }}-alb-sg"
        listeners:
          - Protocol: HTTP
            Port: 80
            DefaultActions:
              - Type: forward
                TargetGroupName: "{{ project_name }}-tg"
        state: present

    - name: Create auto scaling group across AZs
      amazon.aws.autoscaling_group:
        name: "{{ project_name }}-app-asg"
        region: "{{ aws_region }}"
        launch_template:
          launch_template_name: "{{ project_name }}-app-lt"
        min_size: "{{ min_size }}"
        max_size: "{{ max_size }}"
        desired_capacity: "{{ min_size }}"
        vpc_zone_identifier:
          - "{{ priv_a.subnet.id }}"
          - "{{ priv_b.subnet.id }}"
        tags:
          - Project: "{{ project_name }}"
        state: present

    - name: Create DB subnet group (multi-AZ)
      amazon.aws.rds_subnet_group:
        name: "{{ project_name }}-db-subnets"
        region: "{{ aws_region }}"
        description: "DB subnets for {{ project_name }}"
        subnets:
          - "{{ priv_a.subnet.id }}"
          - "{{ priv_b.subnet.id }}"
        state: present

    - name: Create RDS instance (Multi-AZ)
      amazon.aws.rds_instance:
        id: "{{ project_name }}-db"
        region: "{{ aws_region }}"
        engine: postgres
        db_instance_class: db.t3.micro
        allocated_storage: 20
        master_username: "{{ db_username }}"
        master_user_password: "{{ db_password }}"
        db_subnet_group_name: "{{ project_name }}-db-subnets"
        multi_az: true
        publicly_accessible: false
        state: present
{% endraw %}