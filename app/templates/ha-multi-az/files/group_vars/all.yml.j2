min_size: {{ min_size | default(2) }}
max_size: {{ max_size | default(4) }}
db_username: "{{ db_username | default('appadmin') }}"
db_password: "{{ db_password | default('CHANGE_ME_IN_VAULT') }}"

common_tags:
