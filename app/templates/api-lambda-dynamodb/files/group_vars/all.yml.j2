---
# Generated by Ansible-Z for environment: {{ env }}
project_name: "{{ project_name }}"
environment_name: "{{ env }}"
aws_region: "{{ aws_region }}"
lambda_runtime: "{{ lambda_runtime | default('python3.12') }}"
lambda_handler: "{{ lambda_handler | default('app.handler') }}"
lambda_zip: "{{ lambda_zip | default('api.zip') }}"
api_stage: "{{ api_stage | default('prod') }}"

# Replace with your real OpenAPI/Swagger definition (with Lambda integrations).
api_swagger: |
  {"swagger": "2.0", "info": {"title": "{{ project_name }}", "version": "1.0"}, "paths": {}}

common_tags:
  Project: "{{ project_name }}"
  Environment: "{{ env }}"
  ManagedBy: ansible
  GeneratedBy: ansible-z
