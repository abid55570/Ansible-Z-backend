{% raw %}---
- name: Find public subnet
  amazon.aws.ec2_vpc_subnet_info:
    region: "{{ aws_region }}"
    filters:
      "tag:Role": public
  register: public_subnets

- name: Launch bastion host
  amazon.aws.ec2_instance:
    name: "{{ project_name }}-bastion"
    region: "{{ aws_region }}"
    instance_type: t3.micro
    image_id: "{{ bastion_ami | default(omit) }}"
    vpc_subnet_id: "{{ public_subnets.subnets[0].id }}"
    network:
      assign_public_ip: true
    security_group: "{{ project_name }}-bastion-sg"
    tags: "{{ common_tags | combine({'Role': 'bastion'}) }}"
    state: present
  when: public_subnets.subnets | length > 0
{% endraw %}