# Copy to .env and fill in. Non-secret defaults are fine for local dev.

APP_NAME=Neviri-Ansi API
ENV=local

# Security — generate a long random string for JWT_SECRET in real envs
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=1440

# Google Sign-In — this is the public Client ID (safe to expose). No client secret needed for ID-token verification.
GOOGLE_CLIENT_ID=690200002280-k5lahp261g9d93rc2s0fp9hr6g7b16c1.apps.googleusercontent.com

# Postgres (you will provide the real connection string)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ansiblez

# Object storage provider: "s3" or "swift"
STORAGE_PROVIDER=s3

# --- Option A: S3-compatible (AWS S3 / Cloudflare R2 / MinIO / Supabase) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Option B: OpenStack Swift (Keystone v3 application credential) ---
# OS_AUTH_URL=https://<host>:5000/v3
# OS_APP_CRED_ID=
# OS_APP_CRED_SECRET=        # SECRET — keep only in .env, never commit
# OS_REGION=sin1
# SWIFT_CONTAINER=ansible-z
# OS_VERIFY_TLS=false        # set false only for self-signed/IP endpoints

# CORS
FRONTEND_ORIGIN=http://localhost:3000
